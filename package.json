{
	"name": "fmp-sdk",
	"version": "1.0.0-beta.1",
	"description": "Financial Modeling Prep (FMP) SDK",
	"repository": {
		"type": "git",
		"url": "https://github.com/gorango/fmp.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/api.d.ts",
			"import": "./dist/api.js"
		},
		"./types": {
			"types": "./dist/types.d.ts"
		},
		"./tools": {
			"types": "./dist/generated/tools.d.ts",
			"import": "./dist/generated/tools.js"
		},
		"./constants": {
			"types": "./dist/constants/index.d.ts",
			"import": "./dist/constants/index.js"
		},
		"./constants/returns": {
			"types": "./dist/constants/returns.d.ts",
			"import": "./dist/constants/returns.js"
		},
		"./constants/categories": {
			"types": "./dist/constants/categories.d.ts",
			"import": "./dist/constants/categories.js"
		},
		"./sec": {
			"types": "./dist/sec/index.d.ts",
			"import": "./dist/sec/index.js"
		}
	},
	"scripts": {
		"lint": "oxlint --fix & oxfmt",
		"typecheck": "tsc --noEmit",
		"test:api": "vitest run",
		"coverage": "vitest run --coverage",
		"build": "tsc --project tsconfig.json",
		"generate:tools": "npx tsx ./src/scripts/tools.ts",
		"generate:docs": "npx tsx ./src/scripts/docs.ts",
		"generate:embeddings": "npx tsx ./src/scripts/embed.ts",
		"generate:stocks": "npx tsx ./src/scripts/stocks.ts",
		"retrieve": "npx tsx ./src/retrieve.ts",
		"sandbox": "tsx --watch-path=sandbox/ --env-file .env sandbox/index.ts",
		"seed:filings": "tsx --env-file .env seed/filings.ts"
	},
	"dependencies": {
		"ai": "^6.0.191",
		"ioredis": "^5.11.0",
		"ky": "^2.0.2",
		"papaparse": "^5.5.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@ai-sdk/openai": "^3.0.65",
		"@types/node": "^25.9.1",
		"@types/papaparse": "^5.5.2",
		"@vitest/coverage-v8": "4.1.7",
		"dotenv": "^17.4.2",
		"oxfmt": "^0.52.0",
		"oxlint": "^1.67.0",
		"ts-morph": "^28.0.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.7"
	}
}
